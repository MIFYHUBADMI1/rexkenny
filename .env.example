# ============================================================
# REX KENNY MUSIC — environment template
# Copy to .env.local and fill in REAL values. Never commit secrets.
# The site runs without these filled in: unconfigured integrations
# report "Not connected" instead of fake data.
# ============================================================

# --- Site ---------------------------------------------------
# Canonical origin used for metadata, sitemaps, OG tags and JSON-LD.
# Leave this unset to get the production default (https://rexkenny.atai.ink),
# which is what previews and share cards should show. Set it per environment
# only if the site is served from a different host.
NEXT_PUBLIC_SITE_URL=https://rexkenny.atai.ink

# --- Supabase (database, auth, storage) ---------------------
# Project URL + ANON key are public by design (protected by RLS).
# NEVER expose SUPABASE_SERVICE_ROLE_KEY to the frontend.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Abuse throttling ---------------------------------------
# The contact form stores only a salted SHA-256 of the sender's IP, never the
# address. Change this salt and every existing throttle window resets.
IP_SALT=

# --- Google OAuth (Supabase > Authentication > Providers) ---
# Configure in Supabase dashboard; these are only needed if you
# build server-side OAuth flows beyond Supabase's built-in ones.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Resend (transactional + campaign email) ----------------
# Requires a verified sending domain with SPF, DKIM and DMARC. No email is sent
# until RESEND_API_KEY is set AND the address below is a domain you control —
# double opt-in only, no unsolicited sending.
RESEND_API_KEY=
EMAIL_FROM_NAME=REX KENNY MUSIC
EMAIL_FROM_ADDRESS=

# --- Google Analytics 4 -------------------------------------
# Leave empty to disable GA entirely (nothing is faked).
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# --- Google Search Console ----------------------------------
# Verification token shown in <head> after you verify the property.
NEXT_PUBLIC_GSC_SITE_VERIFICATION=

# --- Sentry (error monitoring, optional) --------------------
NEXT_PUBLIC_SENTRY_DSN=

# --- AI assistant (admin-only, optional) --------------------
# Keys stay server-side; admin reviews all generated content.
# Provider: openai, openrouter, groq, together, mistral, deepseek, anthropic,
# gemini, or "custom" for any other OpenAI-compatible endpoint (then also set
# AI_BASE_URL, e.g. http://localhost:11434/v1 for Ollama).
AI_PROVIDER=
AI_MODEL=
AI_BASE_URL=
AI_API_KEY=
